{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usaspending-commongrants-api",
  "main": "src/worker.ts",
  // Same compatibility date and flags as the state APIs (cg-api-ca and siblings).
  "compatibility_date": "2026-03-20",
  "compatibility_flags": ["nodejs_compat"],
  // Naming convention: {source}-{data domain}-{purpose}, following the state
  // APIs' {state}-grants-{purpose}.
  "r2_buckets": [
    {
      // Raw upstream records: the newest copy of each under records/, every
      // version under history/ (expired after a year by a lifecycle rule).
      "binding": "SNAPSHOTS",
      "bucket_name": "usaspending-awards-snapshots",
    },
  ],
  // What the API serves. Created once by scripts/bootstrap.sh, which also
  // applies migrations/; later schema changes need `wrangler d1 migrations apply`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "usaspending-awards-db",
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  // The daily refresh outlasts one invocation, so it runs as a Workflow.
  "workflows": [
    {
      "name": "usaspending-awards-sync",
      "binding": "SYNC",
      "class_name": "SyncWorkflow",
    },
  ],
  // Reading a USAspending download (about 500,000 CSV rows across the fiscal
  // years) took about a second of CPU locally; matching, hashing and building
  // D1 writes add a few more. 60 seconds leaves wide headroom over the
  // 30-second default. Raising it, and Workflows themselves, need the Workers
  // Paid plan.
  "limits": {
    "cpu_ms": 60000,
  },
  // The custom domain, usaspending.api.cg.a6lab.ai, is attached in the
  // Cloudflare dashboard, not listed under "routes", as in the state APIs.
  // Wrangler re-applies listed custom domains on every deploy, which needs
  // access to the a6lab.ai zone that CI's per-Worker token doesn't have.
  //
  // Production also answers at
  // usaspending-commongrants-api.<subdomain>.workers.dev, and each PR preview,
  // a version uploaded without deploying, at
  // <alias>-usaspending-commongrants-api.<subdomain>.workers.dev.
  "workers_dev": true,
  "preview_urls": true,
  "triggers": {
    // Start the refresh once a day. USAspending loads new award data daily, so
    // running more often would only re-fetch the same records. 08:00 UTC is
    // after the overnight load, and matches cg-api-md.
    "crons": ["0 8 * * *"],
  },
  "vars": {
    "ENVIRONMENT": "production",
  },
  // Secrets, set with `wrangler secret put` (never in this file):
  //   SGG_API_KEY   Simpler.Grants.gov API key, used by the refresh
  //   SYNC_SECRET   Bearer token for POST /admin/sync
  "observability": {
    "enabled": true,
  },
}
